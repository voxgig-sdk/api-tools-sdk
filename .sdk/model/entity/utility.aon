# Entity: utility

main: kit: entity: utility: {

  alias: field: {}

  fields: [
    {
      name: "city"
      req: false
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ip"
      req: false
      type: "`$STRING`"
    }
    {
      name: "iso"
      req: false
      short: "ISO 8601 formatted date"
      type: "`$STRING`"
    }
    {
      name: "isp"
      req: false
      type: "`$STRING`"
    }
    {
      name: "milliseconds"
      req: false
      short: "Unix timestamp in milliseconds"
      type: "`$INTEGER`"
    }
    {
      name: "timestamp"
      req: false
      short: "Unix timestamp in seconds"
      type: "`$INTEGER`"
    }
    {
      name: "utc"
      req: false
      short: "UTC formatted date"
      type: "`$STRING`"
    }
  ]

  name: "utility"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "ip"
                orig: "ip"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/ip"
          parts: [
            "api"
            "ip"
          ]
          select: {
            exist: [
              "ip"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/timestamp"
          parts: [
            "api"
            "timestamp"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
